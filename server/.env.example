PORT=9010
DATABASE_URL=postgresql://snk:snk_local_dev@localhost:55432/snk_onchain?schema=public
# Optional, server-only; never use VITE_ for these values.
X_BEARER_TOKEN=
X_USER_ID=

# If your system proxy is not inherited by the terminal, configure the actual proxy here.
# These are inherited by the baw child process. NODE_USE_ENV_PROXY requires Node 24+.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NODE_USE_ENV_PROXY=1
# NO_PROXY=localhost,127.0.0.1

# Mint monitor: no automatic scanning or live broadcast by default.
MINT_MONITOR_ENABLED=false
MINT_MONITOR_INTERVAL_MS=1800000
MINT_MONITOR_CHAIN_IDS=56
MINT_MONITOR_BATCH_SIZE=5
MEME_DISCOVERY_ENABLED=false
SOCIAL_RESEARCH_ENABLED=false
AGENT_EXECUTION_ENABLED=false
MINT_AUTO_EXECUTE=false
MINT_MAX_GAS_WEI=1000000000000000
# HTTPS RPC or loopback fork endpoint; must report BSC chain ID 56.
BSC_RPC_URL=
BAW_PATH=baw
# Optional override paths to the installed official skills:
# TOKEN_INFO_CLI_PATH=/absolute/path/to/query-token-info/scripts/cli.mjs
# MEME_RUSH_CLI_PATH=/absolute/path/to/meme-rush/scripts/cli.mjs

# Market: uses the local official gmgn-cli and its ~/.config/gmgn/.env API key.
# GMGN_CLI_PATH=gmgn-cli
# KOL: xapi.to read-only public profile/posts, manual sync only.
XAPI_KEY=
# Shared X watchlist owned by Agent Wallet Manager. Sync imports accounts only.
# KOL_SHARED_WATCHLIST_PATH=/home/box/.config/shared/x-mint-bloggers.json

# Optional read-only RPC for the BNB Agent launchpad market; independent from mint execution.
# Falls back to BSC_RPC_URL, then the public BSC RPC. Must report chain ID 56.
MARKET_BSC_RPC_URL=

# Detection only: local registry for non-launchpad fair mints; never a wallet/session file.
# EXTERNAL_FAIR_MINT_FILE=/absolute/path/to/fair-mints.json
AGENT_LAUNCH_DETECTION_ENABLED=false
# Optional ledger destination for delegated success. Defaults to data/baw-free-mints.json.
# BAW_MINT_LEDGER_PATH=/absolute/path/to/baw-free-mints.json
